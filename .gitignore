examples/music_player/music/*.flac
examples/music_player/music/*.lrc
examples/multimedia_demo/*.mp3
examples/**/*.wav
examples/**/*.ogg

# 打包文件（发行版使用）
*.cjp

# 发布流程中间产物（7z 归档及解压目录，通过 GitCode Releases 分发，不入库）
releases/**/*.7z
releases/**/windows_x64_*/
releases/**/linux_x64_*/

# Linux交叉编译输出
build_linux/

# 操作系统伪设备/临时文件
nul

# 二进制文件不纳入版本控制
*.dll
*.exe
*.lib
*.pdb

# 预编译包保留在releases目录供下载
!releases/*.cjp
!releases/**/*.so
!releases/**/*.dll
!releases/**/*.dll.a
!releases/**/*.lib

# 实验性合并产物（非发布内容，勿提交；放置在否定规则之后以重新忽略）
releases/windows-x64/libcjqt6_bridge_merged.dll.a
releases/windows-x64/libcjqt6_bridge_new.lib
releases/windows-x64/libcjqt6_bridge.dll.a.bak
releases/windows-x64/tmp_merge/

# ============================================================
# CJQT6 skill 例外：仅 .agents/skills/cjqt6/SKILL.md 纳入版本控制
# ============================================================
# 上文已有 `.agents/` 整目录忽略。git 规则：父目录被忽略时无法直接
# re-include 其子文件，必须从 .agents 起逐层放开，再兜底忽略其余内容。
!.agents/
!.agents/skills/
# 忽略 skills 下所有子项（其余 30+ 个 cangjie 技能不提交）
.agents/skills/*
!.agents/skills/cjqt6/
!.agents/skills/cjqt6/SKILL.md
# 兜底：忽略 .agents 下除 skills 外的临时内容（tmp-cangjie-skills/、tmp-docs-03.md 等）
.agents/*
!.agents/skills/

# 示例运行时产物（数据库与调试输出不入库）
examples/**/*.db
examples/**/stderr_*.txt

# 示例运行时接收目录（文件传输产物）
examples/**/recv/
